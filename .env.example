# ==========================================================================
# Variables de entorno. Copiar a .env y completar.
#
# El generador crea .env con secretos aleatorios la primera vez y NO lo pisa
# en corridas siguientes (usar --force para regenerarlo, lo cual ROTA las
# credenciales: despues hay que recrear los roles con `docker compose up`).
# ==========================================================================

# --- Runtime -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
TZ=America/Argentina/Buenos_Aires

# --- Postgres ------------------------------------------------------------
# POSTGRES_SUPERUSER solo bootstrap: crea roles y corre los scripts de init.
# Los dos salen del nombre del proyecto (`--name`), como los contenedores.
POSTGRES_SUPERUSER=cms_sas_root
POSTGRES_SUPERUSER_PASSWORD=cambiame
POSTGRES_DB=cms_sas
# Extensiones de Postgres habilitadas, separadas por coma (vacio = ninguna).
# Lo pone el generador (pregunta interactiva o --extensions/--no-extensions) y
# de aca sale la imagen de Postgres y el SQL de docker/postgres/roles.sh.
POSTGRES_EXTENSIONS=postgis
# Password de cada rol (ver docker/postgres/roles.sh)
MIGRATOR_DB_PASSWORD=cambiame
APP_DB_PASSWORD=cambiame
PLATFORM_DB_PASSWORD=cambiame
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
REDIS_BROKER_PASSWORD=cambiame
REDIS_CACHE_PASSWORD=cambiame
REDIS_BROKER_PORT=6379
REDIS_CACHE_PORT=6380
REDIS_BROKER_MAXMEMORY=256mb
REDIS_CACHE_MAXMEMORY=256mb

# --- Secretos de la app --------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=cambiame
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
# Clave Fernet para las credenciales por tenant:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=cambiame

# --- Multi-tenancy -------------------------------------------------------
# Dominio base del SaaS: los clubes quedan en <slug>.cms-sas.pro y
# el backoffice de plataforma en admin.<dominio base> (el apex es la landing).
# En desarrollo *.localhost ya resuelve a 127.0.0.1 en Chrome/Edge.
# En produccion tiene que ser el dominio real: con *.localhost no hay
# certificado posible y Traefik responde 404 para cualquier otro Host.
SAAS_BASE_DOMAIN=cms-sas.localhost
PLATFORM_ADMIN_EMAIL=admin@cms-sas.localhost
PLATFORM_ADMIN_PASSWORD=cambiame
# Tenant de ejemplo creado en el bootstrap (dejar vacio para no crearlo).
# El slug tiene que coincidir con el `club` del sitio de Auxilio RB
# (frontend/src/auxiliosrb/site.tsx).
FIRST_TENANT_SLUG=demo
FIRST_TENANT_NAME=Auxilio RB
FIRST_TENANT_ADMIN_EMAIL=admin@demo.cms-sas.localhost
FIRST_TENANT_ADMIN_PASSWORD=cambiame

# --- Object storage ------------------------------------------------------
MINIO_ROOT_USER=cms_sas_minio
MINIO_ROOT_PASSWORD=cambiame
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=cms-sas
S3_REGION=us-east-1

# --- Traefik / TLS -------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_LOG_LEVEL=INFO
# Solo produccion (docker-compose.prod.yml):
ACME_EMAIL=admin@cms-sas.pro
# Nombre del provider DNS de Traefik: cloudflare, route53, gandiv5, hetzner...
ACME_DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=
# Alternativa al token: Global API Key + email de la cuenta Cloudflare.
CF_DNS_API_EMAIL=
CF_DNS_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_HOSTED_ZONE_ID=
GANDIV5_API_KEY=
HETZNER_API_KEY=

# --- Backups -------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
